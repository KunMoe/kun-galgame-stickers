# nextmoe-infra catalog — the identity registry for games and characters.
# KUN_CATALOG_API_KEY is an application key (nmk_live_ / nmk_test_) minted in
# the developer portal for this site's OAuth client, scoped catalog:read.
# Leave it empty and the game/character pickers answer 503 while every page
# keeps rendering the free-text names already stored.
KUN_CATALOG_BASE_URL=http://127.0.0.1:9281
KUN_CATALOG_API_KEY=

# nextmoe-infra community service — the comment thread under each pack.
# Authenticates with the same OAuth client credentials as the image service;
# the tenant comes from that client's oauth_clients binding -- community_site
# when set, catalog_site otherwise -- and is never sent. Empty and pack pages
# simply have no comment section.
KUN_COMMUNITY_BASE_URL=http://127.0.0.1:9282
