PUBLIC_KUN_STICKER_THEME = "kun-sticker-theme"

KUN_DATABASE_URL = "postgresql://user:password@127.0.0.1:5432/kungalgame_sticker"

# KUN OAuth (confidential client; SSR backend holds the secret).
# Dev defaults assume the OAuth server runs at 127.0.0.1:9277 and this app
# at localhost:5173 — adjust per environment. Production should use the
# `https://oauth.kungal.com/api/v1` base URL and the deployed callback URL.
KUN_OAUTH_SERVER_URL = "http://127.0.0.1:9277/api/v1"
KUN_OAUTH_CLIENT_ID = ""
KUN_OAUTH_CLIENT_SECRET = ""
KUN_OAUTH_REDIRECT_URI = "http://localhost:5173/auth/callback"
