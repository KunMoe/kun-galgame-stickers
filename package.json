{
  "name": "kun-galgame-sticker-sveltekit",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "prisma:push": "pnpx prisma db push",
    "prisma:generate": "pnpx prisma generate",
    "start": "cross-env HOST=127.0.0.1 PORT=9420 pm2 start ecosystem.config.cjs",
    "stop": "pm2 delete kun-visual-novel-sticker",
    "deploy:install": "esno scripts/deployInstall.ts",
    "deploy:build": "esno scripts/deployBuild.ts"
  },
  "devDependencies": {
    "@fontsource/fira-mono": "^5.2.7",
    "@iconify/svelte": "^5.2.1",
    "@neoconfetti/svelte": "^2.2.2",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.9.1",
    "cross-env": "^10.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.0",
    "sass": "^1.99.0",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "type": "module",
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "dotenv": "^17.4.2",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.2",
    "prisma": "^7.8.0",
    "sveltekit-i18n": "^2.4.2"
  }
}
