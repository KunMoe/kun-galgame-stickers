generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model sticker {
  id  Int    @id @default(autoincrement())
  sid Int    @default(0)
  pid Int    @default(0)
  src String @default("")

  game Json
  loli Json

  vndb     Int    @default(0)
  describe String @default("")

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@unique([sid, pid])
}
